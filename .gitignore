# ============================================================
# 2-Pyramid For Android — workspace-level .gitignore
# ============================================================
# This file covers everything that should NOT be public on GitHub.
# All build outputs, IDE state, and dev-only tools are excluded
# from the public repository.

# ── Gradle / Android build artifacts ───────────────────────
.gradle/
build/
.kotlin/
*.iml
captures/
.cxx/
local.properties
app/src/main/jniLibs/
app/build/
app/release/
app/debug/

# ── Native / Rust build artifacts ──────────────────────────
target/
*.so
*.a
*.rlib
*.d
*.o

# ── IDE / Editor ───────────────────────────────────────────
.idea/
.vscode/
.trae/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── APK + builds (do not commit binary releases) ──────────
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar

# ── Logs / temp ────────────────────────────────────────────
*.log
*.log.*
build-*.log
build-*.err

# ── Dev scripts + temp (one-off fixes / debug helpers) ────
fix-encoding.py
parse-dump.py
apk-explore.py
apk-extract.zip
dump.xml
libtest.rlib
app-debug.apk
test-*.py
debug-*.png
screenshot-*.png

# ── Personal / local-only config (has hardcoded paths) ────
# Rust target config uses absolute staging path on dev box;
# see convert-core/.gitignore for details.
Rust-convert-src
vue
tools/rustc-aarch64-wrapper.bat
tools/rustc-aarch64-wrapper.cmd
tools/rustc-aarch64-wrapper.ps1
app-debug.apk
libtest.rlib
dump.xml
apk-explore.py
apk-extract.zip
fix-encoding.py
parse-dump.py

# ── Dev-only docs (mentions personal paths, dev workflow) ──
# Useful for the maintainer on their own box, not for the public repo.
AGENTS.md
tools/fix-aarch64-std.md

# ── Generated / re-creatable ───────────────────────────────
# UniFFI Kotlin bindings (regenerated by tools/build-rust-android.bat)
# Keep these in .gitignore so contributors regenerate on their box,
# avoiding platform-specific .kt files getting committed by accident.
2fa-android/app/src/main/kotlin/com/twopyramid/twofa/uniffi/uniffi/

# ── Output APK symlinks (developer convenience) ────────────
app-debug.apk
*.apk.local
