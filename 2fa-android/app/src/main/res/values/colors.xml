<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动器图标底板颜色（Precision Geometry：白底圆角板）。
         由 mipmap-anydpi-v26/ic_launcher.xml / ic_launcher_round.xml 的 <background> 引用。 -->
    <color name="launcher_background">#FFFFFFFF</color>

    <!-- 启动窗口 / Android 12 SplashScreen 底色（与 ui/theme/Color.kt 的 LightScheme/DarkScheme
         background 一致，避免启动白闪；夜间由 values-night/themes.xml 引用 launch_background_dark）。 -->
    <color name="launch_background_light">#FFF4F2EE</color>
    <color name="launch_background_dark">#FF1A1815</color>
</resources>
